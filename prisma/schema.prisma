generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  email     String?       @unique
  phone     String?
  website   String?
  logo      String?
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users     User[]

  @@index([status])
  @@map("companies")
}

model User {
  id            String     @id @default(uuid())
  companyId     String?
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(WORKER)
  phone         String?
  avatar        String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company       Company?   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([role])
  @@index([status])
  @@index([companyId, role, status])
  @@map("users")
}
